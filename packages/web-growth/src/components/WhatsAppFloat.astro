---
// Floating WhatsApp button (from paavai-embroidery-web). `phone` is the full number
// with country code and no "+", e.g. "919876543210". Clicks are tracked by
// scripts/tracking.ts through the data-wa attribute.
interface Props {
  phone: string;
  greeting?: string;
  label: string;
}
const { phone, greeting, label } = Astro.props;
const href = `https://wa.me/${phone}${greeting ? `?text=${encodeURIComponent(greeting)}` : ''}`;
---

<a class="wa-float" href={href} data-wa="floating-button" rel="noopener" aria-label={label}>
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" fill="currentColor">
    <path
      d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 7L3 29l6.4-2c2 1.1 4.3 1.7 6.6 1.7 7.2 0 13-5.7 13-12.8S23.2 3 16 3Zm0 23.4c-2.1 0-4.1-.6-5.9-1.7l-.4-.3-3.8 1.2 1.2-3.7-.3-.4a10.6 10.6 0 0 1-1.8-5.9C5 9.9 9.9 5.2 16 5.2s11 4.7 11 10.6-4.9 10.6-11 10.6Zm6-7.9c-.3-.2-2-1-2.3-1.1-.3-.1-.5-.2-.8.2l-1 1.3c-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.7-1.6-1-.9-1.7-2-1.9-2.3-.2-.3 0-.5.1-.7l.5-.6.4-.6c.1-.2 0-.4 0-.6l-1-2.5c-.3-.7-.6-.6-.8-.6h-.7c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.3 1.4 3.5c.2.2 2.4 3.7 5.9 5.1 2.9 1.1 3.5.9 4.1.8.6-.1 2-.8 2.3-1.6.3-.8.3-1.5.2-1.6l-.6-.4Z"
    ></path>
  </svg>
  <span class="wa-float__label">{label}</span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 30;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 56px;
    padding: 0 18px 0 14px;
    border-radius: 999px;
    background: var(--whatsapp);
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    box-shadow: 0 8px 24px rgb(18 140 74 / 0.35);
  }
  .wa-float:hover {
    color: #fff;
    background: #0e7a40;
  }
  @media (max-width: 480px) {
    .wa-float__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .wa-float {
      padding: 0 14px;
    }
  }
</style>
