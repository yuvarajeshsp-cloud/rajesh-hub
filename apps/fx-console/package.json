{
  "name": "@rajesh-hub/fx-console",
  "private": true,
  "version": "1.0.0",
  "description": "Trading Console: live view of the fx-futures-trader skills (scanner, calendar, plan, time machine, risk, broker).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:replay": "tsc -b && vite build --mode replay --base ./ --outDir dist-replay",
    "preview": "vite preview",
    "serve": "python3 server.py",
    "demo": "python3 server.py --demo"
  },
  "dependencies": {
    "@rajesh-hub/ui": "*",
    "@rajesh-hub/tokens": "*",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "lucide-react": "^1.6.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.1",
    "typescript": "~5.9.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
